# ─────────────────────────────────────────────────────────────────────────
# THIS FILE IS COMMITTED. NO REAL VALUE EVER GOES IN IT.
#
# It is the shape of the configuration, not the configuration: every key
# here is either a safe default or empty. Real keys live in .env, which is
# ignored by git and never leaves this machine.
#
# Written down because it already happened once: a working Gemini key was
# pasted into GEMINI_API_KEY below, and GitHub refused the push — which is
# the only reason it was caught. A push protection rule is not a policy;
# it is the last line of one.
# ─────────────────────────────────────────────────────────────────────────
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Object storage ──────────────────────────────────────────────────────
# Audio does not live in the database and it should not live on the web
# server either. Both options below speak the S3 protocol, which is the
# whole point: the application knows one protocol and the provider is a
# variable. Filling these in does NOT switch anything — FILESYSTEM_DISK
# and the `disk` column on sound_files decide where files actually go, so
# a new provider can be configured, tested from Admin → Storage, and only
# then switched on.

# Cloudflare R2. Free tier: 10 GB stored, and egress is not charged at all.
# Endpoint looks like https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PUBLIC_URL=

# Backblaze B2, via its S3-compatible endpoint (not the native B2 API).
# Endpoint looks like https://s3.us-west-004.backblazeb2.com
# B2_ACCESS_KEY_ID=
# B2_SECRET_ACCESS_KEY=
# B2_REGION=us-west-004
# B2_BUCKET=
# B2_ENDPOINT=
# B2_PUBLIC_URL=

# ─── PayPal ──────────────────────────────────────────────────────────────
# Unlike the Google and captcha keys — which are stored encrypted in the
# `settings` table and edited from Admin — payment credentials live here
# and only here. The reason is Admin → Backups: a database dump is a file
# that gets downloaded and emailed, and a live payment secret inside one is
# somebody taking money in dbelo's name. config/services.php has the full
# argument.
#
# Both environments have their OWN client id and secret. They are not
# interchangeable, and a live credential in sandbox mode simply fails to
# authenticate — which is the safe direction.
#
# Get them at developer.paypal.com → Apps & Credentials → Sandbox (or Live)
# → Create App. Paste them here; they must never be committed to git.

# 'sandbox' or 'live'. ANYTHING that is not exactly 'live' is treated as
# sandbox, on purpose: a typo must not be the reason a real card is charged.
PAYPAL_MODE=sandbox

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Created when the webhook is registered (Apps & Credentials → the app →
# Webhooks → Add). Until it is set, incoming webhooks are REJECTED rather
# than trusted: an unverified webhook endpoint is "anybody who can POST
# JSON gets Pro forever".
PAYPAL_WEBHOOK_ID=

# Shown on PayPal's own checkout screen. If it does not match the site the
# buyer was on a second earlier, they abandon.
PAYPAL_BRAND_NAME="dbelo"

# PayPal plans are created in one currency and cannot change it afterwards.
# Changing this once subscriptions exist is a migration, not a setting.
PAYPAL_CURRENCY=USD

VITE_APP_NAME="${APP_NAME}"

# ─── Metadata suggestions (tags, category, meta description) ─────────────
# ALL OF THIS IS EDITABLE IN Admin → Settings → Suggestions, and a value set
# there WINS over what is written here. Unlike PayPal, whose credentials live
# in this file and only in this file: a leaked model key spends a quota and is
# revoked from a console in seconds, where a leaked payment secret is somebody
# taking money in dbelo's name. App\Support\Suggestions has the full argument.
#
# What is here is the fallback for a fresh install and the escape hatch for a
# server. The panel prints which of the two is actually in effect.
#
# Two drivers behind one switch, so both can be run over the same sounds and
# compared. 'gemini' or 'openai'.
#
# Their free tiers are NOT the same offer:
#   gemini  free, no card. Google may use what is sent to improve products.
#   openai  no signup credits. Free daily tokens via an opt-in data-sharing
#           programme (used for training), and a card is still required.
#
# dbelo only ever sends a filename and a duration for a sound that will be
# public anyway. Nothing private goes through either one.

AI_PROVIDER=gemini

# aistudio.google.com → Get API key
#
# Pin an exact model id, never a "-latest" alias: Google hot-swaps what an
# alias points at, so the descriptions written after that day come out of a
# different model with nothing on this end recording when it changed. To see
# exactly which ids YOUR key can use:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# platform.openai.com → API keys
# Same idea for the list your key can use:
#   curl -s -H "Authorization: Bearer $OPENAI_API_KEY" https://api.openai.com/v1/models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Seconds. This runs in a queue where nobody is waiting, so it can be
# generous — but a hung request holds a worker that has 49 other sounds to
# get through, so it is not unbounded.
AI_TIMEOUT=45
