<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ── ONE HOST, AND THIS IS THE ONLY PLACE THAT ENFORCES IT ─────────
    #
    # This cPanel account's PRIMARY domain is gooova.com; dbelo.com is an
    # addon domain. cPanel always creates a subdomain of the primary for
    # an addon domain, pointing at the SAME document root -- here
    # www.dbelo.com.gooova.com. Nobody asked for it and nothing announced
    # it, so the whole site was reachable twice.
    #
    # Google found the second address, and the application confirmed it:
    # sitemap.xml built every <loc> with route(), and every page's
    # rel=canonical came from url()->current(). Both build from the host
    # of the REQUEST, so the site handed Google a complete, self-
    # consistent map of itself living at a hostname that is not its own.
    # Searching "dbelo" returned the gooova subdomain, not dbelo.com.
    #
    # WHY THIS CANNOT HURT gooova.com: an .htaccess only runs for requests
    # Apache routed to ITS document root. gooova.com has a different
    # document root and its own file. This rule is only ever reached by a
    # request that was already being served the dbelo application.
    #
    # It also folds www.dbelo.com into dbelo.com, which is the same
    # duplicate-content problem with a more familiar name.
    #
    # THE .well-known EXCEPTION IS NOT OPTIONAL. AutoSSL renews a
    # certificate by fetching http://<host>/.well-known/acme-challenge/...
    # and reading what comes back. Redirecting that away makes validation
    # fail for every hostname on this account that is not dbelo.com, and a
    # shared certificate that stops renewing takes the working names down
    # with it. Excluding the path costs nothing and removes the risk.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} !^dbelo\.com$ [NC]
    RewriteRule ^ https://dbelo.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ── WHY A cPanel BLOCK LIVES IN VERSION CONTROL ────────────────────────
#
# cPanel wrote the block below on the server, and it is not decoration: it
# is what makes Apache run this site on PHP 8.3 instead of the host's
# default, which is 7.4 and cannot run the application at all.
#
# It is committed here rather than left as an untracked local edit for one
# reason: public/.htaccess is a TRACKED file. A server-side modification to
# a tracked file means the next `git pull` that touches this file aborts
# with "your local changes would be overwritten" — a deployment that fails
# at the worst time, over a change nobody remembers making.
#
# Herd serves the site through nginx locally and ignores .htaccess
# entirely, so this is inert on the Mac.
#
# If cPanel ever rewrites it, `bin/deploy.sh` will report the file as
# modified again, and that report will mean something.

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
