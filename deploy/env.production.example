# dbelo — plantilla de producción.
# Copiar como .env en el servidor y completar. NUNCA subir a git.

APP_NAME=dbelo
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false               # jamás true en producción: filtra rutas y credenciales
APP_URL=https://dbelo.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning             # 'debug' llena el disco en semanas

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbelo
DB_USERNAME=dbelo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # la cookie no viaja fuera de HTTPS
SESSION_DOMAIN=.dbelo.com

CACHE_STORE=redis
QUEUE_CONNECTION=redis        # más rápido que database bajo carga
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Búsqueda ---
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=              # obligatoria en producción, generar una nueva

# --- Almacenamiento: Cloudflare R2 ---
DBELO_DISK_MASTER=r2
DBELO_DISK_DOWNLOAD=r2
DBELO_DISK_PREVIEW=r2

# Imágenes, no audio: logo, favicon, imagen social, la imagen del login,
# portadas del blog (media) y fotos de perfil (avatars).
#
# Estaban ausentes de esta plantilla, lo que no las dejaba en 'public' por
# decisión sino por descuido: un ajuste que solo existe como valor por
# defecto en el código es un ajuste que nadie encuentra.
#
# 'public' las sirve nginx desde el disco del servidor — simple, y bien para
# archivos pequeños. Cambiá a 'r2' si algún día corrés más de un servidor:
# con disco local, el logo que subís en uno no existe en el otro.
DBELO_DISK_MEDIA=public
DBELO_DISK_AVATARS=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dbelo
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Correo ---
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@dbelo.com"
MAIL_FROM_NAME="dbelo"

# --- Identidad legal ---
DBELO_LEGAL_ENTITY=
DBELO_JURISDICTION=
DBELO_ADDRESS=
DBELO_LEGAL_EMAIL="legal@dbelo.com"
DBELO_SUPPORT_EMAIL="support@dbelo.com"
DBELO_PRIVACY_EMAIL="privacy@dbelo.com"

# --- PayPal (hito 5) ---
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

VITE_APP_NAME="${APP_NAME}"
