APP_NAME=dbelo
APP_ENV=local
APP_KEY=base64:mSroDLAZ/QZYcv32Yy8gAyXoOYOHVuH16waCGBJjxZs=
APP_DEBUG=true
APP_URL=http://dbelo.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# BASE DE DATOS
# Activa: MySQL (DBngin). Requiere haber creado la base "dbelo".
# Si MySQL da problemas, comenta este bloque y descomenta el de SQLite.
# ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbelo
DB_USERNAME=root
DB_PASSWORD=

# --- SQLite (alternativa sin servidor) ---
# DB_CONNECTION=sqlite

# ---------------------------------------------------------------
# BÚSQUEDA (Meilisearch)
# Local:  brew install meilisearch && brew services start meilisearch
# La clave queda vacía en desarrollo; en producción es obligatoria.
# ---------------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------
# CORREO
# 'log' escribe los emails en storage/logs/laravel.log en vez de
# enviarlos: perfecto para desarrollo, no hace falta tocar nada.
#
# Para enviar de verdad (Resend, 3.000 emails/mes gratis):
#   1. Crear cuenta en resend.com y verificar el dominio dbelo.com
#   2. composer require resend/resend-laravel
#   3. Cambiar MAIL_MAILER=resend y pegar la clave abajo
# ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dbelo.com"
MAIL_FROM_NAME="${APP_NAME}"

# RESEND_API_KEY=

# ---------------------------------------------------------------
# ALMACENAMIENTO
# En local todo vive en el disco del proyecto.
# Para pasar a Cloudflare R2, completar las claves de abajo y
# cambiar los tres roles a 'r2'. No hace falta tocar código.
# ---------------------------------------------------------------
DBELO_DISK_MASTER=sounds_private
DBELO_DISK_DOWNLOAD=sounds_private
DBELO_DISK_PREVIEW=public

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dbelo
R2_ENDPOINT=
R2_PUBLIC_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# IDENTIDAD LEGAL
# Completar antes de publicar: aparece en términos, privacidad y
# el acuerdo de colaborador. Si queda vacío, las páginas muestran
# los marcadores entre corchetes.
# ---------------------------------------------------------------
DBELO_LEGAL_ENTITY="[LEGAL ENTITY NAME]"
DBELO_JURISDICTION="[COUNTRY]"
DBELO_ADDRESS="[REGISTERED ADDRESS]"
DBELO_LEGAL_EMAIL="legal@dbelo.com"
DBELO_SUPPORT_EMAIL="support@dbelo.com"
DBELO_PRIVACY_EMAIL="privacy@dbelo.com"
DBELO_LEGAL_DATE="2026-08-18"

VITE_APP_NAME="${APP_NAME}"
